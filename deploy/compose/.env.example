# Forktower — docker compose settings.
#
# Copy to `.env` beside the compose file and fill in the first section. Nothing
# else has to change to get started.
#
#   cp .env.example .env
#   docker compose up -d
#
# This file will hold your node's RPC password. Keep it to yourself:
#   chmod 600 .env

# ── Your Bitcoin node ─────────────────────────────────────────────────────────
#
# The node you already run. Forktower only reads from it — it never sends it
# anything, and it never needs your wallet.
#
# From inside a container, your host is `host.docker.internal` on Docker Desktop
# and usually `172.17.0.1` on Linux. If your node runs in Docker too, use its
# service name.
FORKTOWER_SF_RPC_URL=http://172.17.0.1:8332

# Either a cookie file, or a username and password. The cookie is better where
# you can mount it: it is rewritten when your node restarts, and Forktower
# re-reads it, so a restart does not quietly end the watch.
#FORKTOWER_SF_RPC_COOKIE_PATH=/mnt/bitcoin/.cookie
FORKTOWER_SF_RPC_USER=
FORKTOWER_SF_RPC_PASSWORD=

# Optional, and worth setting: with these, Forktower hears about a new block
# immediately instead of noticing on its next check.
#FORKTOWER_SF_ZMQ_RAWBLOCK=tcp://172.17.0.1:28332
#FORKTOWER_SF_ZMQ_RAWTX=tcp://172.17.0.1:28333

# ── How you want to be told ───────────────────────────────────────────────────
#
# Leave both unset and Forktower will say — plainly, on its own dashboard — that
# it has no way to reach you. That is deliberate: an alarm nobody can hear is
# worth knowing about before you need it.
#
# Whatever you choose here is told the severity and the kind of thing that
# happened, and nothing else — not which channel, not how much, not how long you
# have. That detail stays on this machine, because whoever runs a notification
# service would otherwise learn that you are under attack and roughly when.
#FORKTOWER_NTFY_URL=https://ntfy.sh/pick-something-nobody-will-guess
#FORKTOWER_NTFY_TOKEN=
#FORKTOWER_WEBHOOK_URL=https://example.com/hooks/forktower

# ── The dashboard ─────────────────────────────────────────────────────────────
#
# Which address to serve it on. The default is this machine only. Serving it to
# your network without a password is refused rather than allowed quietly.
FORKTOWER_UI_PORT=8330
FORKTOWER_UI_BIND=127.0.0.1

# "none" is only permitted when the dashboard is bound to this machine.
# Use "password" to reach it from elsewhere, and set the hash below.
FORKTOWER_UI_AUTH=none
# A bcrypt hash, not the password itself. Generate one with:
#   htpasswd -nbBC 12 "" "your password" | cut -d: -f2
#FORKTOWER_UI_PASSWORD_HASH=

# ── The second Bitcoin node ───────────────────────────────────────────────────
#
# Forktower runs one for you: an ordinary Bitcoin Core, on a release that
# predates the new rules, so it follows the other chain by construction rather
# than by configuration. It is pruned and holds no wallet.
#
# This bounds the block store only. The node also keeps a record of unspent
# coins — about 11 GB today, growing with the chain — which pruning does not
# shrink, so the second node needs roughly 31 GB in total at this setting.
# Bitcoin Core refuses anything below about 5,000.
FORKTOWER_SQ_PRUNE_MB=20000

# Peers over Tor by default. A node following only the status-quo chain from your
# own address links the two and marks you as someone with Lightning channels to
# defend — which is useful to exactly the wrong person. Set this to true only if
# you have decided that trade is worth it.
FORKTOWER_SQ_CLEARNET=false

# Extra peers for it, comma-separated. Onion addresses preferred.
#FORKTOWER_SQ_EXTRA_PEERS=abc…xyz.onion:8333,def…uvw.onion:8333

# ── Housekeeping ──────────────────────────────────────────────────────────────
FORKTOWER_LOG_LEVEL=info
FORKTOWER_IMAGE=paulscode/forktower:latest
