# The exact rust-teos this project builds.
#
# **A commit, not a tag.** The most recent release, v0.2.0, is from February
# 2023 and predates three years of fixes — including HTTPS support in the
# watchtower client, which we want. Upstream is in care-and-maintenance with no
# active owner (235 commits in 2022, 10 in 2025), so the tag will not be moved
# on and there will not be another.
#
# The risk being managed here is not that the code is broken. It builds clean
# today. The risk is that nobody upstream will fix it if it stops building, and
# that we would find that out at the worst possible moment — so this pins what
# is known to work and refuses to drift off it quietly.
TEOS_REPO=https://github.com/talaia-labs/rust-teos.git
TEOS_COMMIT=be344ecc5286dd9436bf343d30954135da8ad4ac

# The toolchain the source itself asks for, in rust-toolchain.toml. Repeated
# here so the Dockerfile does not have to parse it, and so a change upstream is
# a build failure rather than a silent switch of compiler.
TEOS_RUST=1.81.0
