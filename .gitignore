# ── Private planning documents and source material (not published) ──
/internal_docs/
/references/

# ── Build output ──
/bin/
/builds/
docker-images/
*.s9pk
node_modules/
javascript/
deno.lock
/scripts/embassy.js

# ── Go ──
*.test
*.out
# Coverage output, anchored to the repository root and named exactly.
#
# This was `coverage.*`, which is a glob over every directory — and it silently
# swallowed internal/responder/tower/coverage.go, a source file. A fresh clone
# did not compile. Anchor and enumerate rather than glob: an ignore rule that
# matches source is invisible until somebody else clones the repository.
/coverage.out
/coverage.html
# Left behind only if `make tidy-check` is interrupted mid-recipe.
*.checkbak

# ── Local runtime data ──
/data/
# Where `make run-dev` keeps its database, so a development run never touches a
# real deployment's data directory.
/.dev/

# ── Credentials and secrets (defensive — none of this should ever be committed) ──
.env
.env.local
*.cookie
*.macaroon
secret.key
/creds/

# ── Local overrides, OS and editor cruft ──
docker-compose.override.yml
docker-compose.override.yaml
.DS_Store
Thumbs.db
*~
*.swp
*.swo
*.bak
tmp/

# Credentials copied out of the forkbench world. Regenerated with
# `forkbench ln-credentials`; they belong to a world rebuilt from nothing.
deploy/forkbench/creds/
